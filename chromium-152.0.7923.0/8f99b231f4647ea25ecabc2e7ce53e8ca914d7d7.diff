+  base::ScopedNativeLibrary tbs_library(base::LoadSystemLibrary(L"tbs.dll"));
+  if (!tbs_library.is_valid()) {
+    return std::nullopt;
+  }
+
+  decltype(Tbsip_Submit_Command)* tbsip_submit_command_proc =
+      reinterpret_cast<decltype(Tbsip_Submit_Command)*>(
+          tbs_library.GetFunctionPointer("Tbsip_Submit_Command"));
+  if (!tbsip_submit_command_proc) {
+    return std::nullopt;
+  }
+
+    TBS_RESULT tbs_result = tbsip_submit_command_proc(
         h_context, TBS_COMMAND_LOCALITY_ZERO, TBS_COMMAND_PRIORITY_NORMAL,
         cmd.data(), cmd.size(), resp.data(), &resp_len);
 
