diff --git a/crypto/unexportable_key_win.cc b/crypto/unexportable_key_win.cc
--- a/crypto/unexportable_key_win.cc
+++ b/crypto/unexportable_key_win.cc
@@ -19,6 +19,7 @@
 #include "base/logging.h"
