+#ifndef MOJO_CORE_USER_MESSAGE_IMPL_H_
+#define MOJO_CORE_USER_MESSAGE_IMPL_H_
+
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "base/memory/raw_ptr_exclusion.h"
