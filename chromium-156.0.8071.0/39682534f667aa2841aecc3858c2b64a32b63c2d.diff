+void CheckNameAndValue(base::trace_event::ProcessMemoryDump* pmd,
+                       const std::string& name,
+                       uint64_t value) {
+  base::trace_event::MemoryAllocatorDump* mad = pmd->GetAllocatorDump(name);
+  ASSERT_TRUE(mad);
