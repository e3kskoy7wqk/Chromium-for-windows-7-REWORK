+extern "C" void WINAPI LibAcquireSRWLockExclusive(PSRWLOCK Lock) {
+    if (!Lock) return;
+
+    FETCH_PROC(L"kernel32.dll", AcquireSRWLockExclusive, PFN_AcquireSRWLockExclusive);
+    if (pfn) { pfn(Lock); return; }
+
+    XP_SRW_FALLBACK* p = XPCompatCreateSRWFallback(Lock);
+    if (!p) return;
+
+    XP_SRW_WAITER waiter;
+    waiter.next = NULL;
+    waiter.shared = FALSE;
+    waiter.granted = FALSE;
+    waiter.event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!waiter.event) return;
+
+    EnterCriticalSection(&p->lock);
+    if (!p->writerActive && p->activeReaders == 0 && p->waitingWriters == 0) {
+        p->writerActive = TRUE;
+        LeaveCriticalSection(&p->lock);
+        CloseHandle(waiter.event);
+        return;
+    }
+
+    p->waitingWriters++;
+    XPCompatSRWAddWaiter(p, &waiter);
+    LeaveCriticalSection(&p->lock);
+
+    WaitForSingleObject(waiter.event, INFINITE);
+    CloseHandle(waiter.event);
+}
+
+extern "C" void WINAPI LibAcquireSRWLockShared(PSRWLOCK Lock) {
+    if (!Lock) return;
+
+    FETCH_PROC(L"kernel32.dll", AcquireSRWLockShared, PFN_AcquireSRWLockShared);
+    if (pfn) { pfn(Lock); return; }
+
+    XP_SRW_FALLBACK* p = XPCompatCreateSRWFallback(Lock);
+    if (!p) return;
+
+    XP_SRW_WAITER waiter;
+    waiter.next = NULL;
+    waiter.shared = TRUE;
+    waiter.granted = FALSE;
+    waiter.event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!waiter.event) return;
+
+    EnterCriticalSection(&p->lock);
+    if (!p->writerActive && p->waitingWriters == 0) {
+        p->activeReaders++;
+        LeaveCriticalSection(&p->lock);
+        CloseHandle(waiter.event);
+        return;
+    }
+
+    p->waitingReaders++;
+    XPCompatSRWAddWaiter(p, &waiter);
+    LeaveCriticalSection(&p->lock);
+
+    WaitForSingleObject(waiter.event, INFINITE);
+    CloseHandle(waiter.event);
+}
+
+extern "C" void WINAPI LibReleaseSRWLockExclusive(PSRWLOCK Lock) {
+    if (!Lock) return;
+
+    FETCH_PROC(L"kernel32.dll", ReleaseSRWLockExclusive, PFN_ReleaseSRWLockExclusive);
+    if (pfn) { pfn(Lock); return; }
+
+    XP_SRW_FALLBACK* p = (XP_SRW_FALLBACK*)Lock->Ptr;
+    if (!p) return;
+
+    EnterCriticalSection(&p->lock);
+    if (p->writerActive) p->writerActive = FALSE;
+    XPCompatSRWGrantWaiters(p);
+    LeaveCriticalSection(&p->lock);
+}
+
+extern "C" void WINAPI LibReleaseSRWLockShared(PSRWLOCK Lock) {
+    if (!Lock) return;
+
+    FETCH_PROC(L"kernel32.dll", ReleaseSRWLockShared, PFN_ReleaseSRWLockShared);
+    if (pfn) { pfn(Lock); return; }
+
+    XP_SRW_FALLBACK* p = (XP_SRW_FALLBACK*)Lock->Ptr;
+    if (!p) return;
+
+    EnterCriticalSection(&p->lock);
+    if (p->activeReaders > 0) p->activeReaders--;
+    if (p->activeReaders == 0) XPCompatSRWGrantWaiters(p);
+    LeaveCriticalSection(&p->lock);
+}
