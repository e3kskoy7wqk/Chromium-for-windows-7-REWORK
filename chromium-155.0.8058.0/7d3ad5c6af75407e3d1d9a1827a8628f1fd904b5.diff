diff --git a/base/win/w2kcompat/xp_kernel32.cpp b/base/win/w2kcompat/xp_kernel32.cpp
new file mode 100644
--- /dev/null
+++ b/base/win/w2kcompat/xp_kernel32.cpp
@@ -0,0 +1,637 @@
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <winternl.h>
+#include "EnlyzeWinCompatLibInternal.h"
+
+typedef void* HSTRING;
+
+// EnlyzeWinCompatLib - Let Clang-compiled applications run on older Windows versions
+// Copyright (c) 2021 Colin Finck, ENLYZE GmbH <c.finck@enlyze.com>
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 mjd7989 - implementations of all functions below.
+
+static void my_memcpy(void* dest, const void* src, size_t num) {
+    unsigned char* d = (unsigned char*)dest;
+    const unsigned char* s = (const unsigned char*)src;
+    while (num--) *d++ = *s++;
+}
+
+#if defined(__clang__) && __has_warning("-Wcast-function-type-mismatch")
+#pragma clang diagnostic ignored "-Wcast-function-type-mismatch"
+#endif
+
+template <typename T>
+static T FetchProcCached(LPCWSTR dllName, const char* procName, T* cacheSlot) {
+    T pfn = (T)InterlockedCompareExchangePointer((PVOID*)cacheSlot, NULL, NULL);
+    if (pfn) return pfn;
+
+    HMODULE hMod = GetModuleHandleW(dllName);
+    if (!hMod) hMod = LoadLibraryW(dllName);
+    if (hMod) {
+        pfn = reinterpret_cast<T>(GetProcAddress(hMod, procName));
+        if (pfn) {
+            InterlockedExchangePointer((PVOID*)cacheSlot, (PVOID)pfn);
+            return pfn;
+        }
+    }
+    InterlockedExchangePointer((PVOID*)cacheSlot, (PVOID)(LONG_PTR)-1);
+    return nullptr;
+}
+
+#define FETCH_PROC_EX(dll, procName, type, varName) \
+    static type pfn_slot_##varName = nullptr; \
+    type varName = nullptr; \
+    if ((LONG_PTR)pfn_slot_##varName != -1) \
+        varName = FetchProcCached<type>(dll, procName, &pfn_slot_##varName)
+
+#define FETCH_PROC(dll, name, type) FETCH_PROC_EX(dll, #name, type, pfn)
+
+// ============================================================================
+// KERNEL32
+// ============================================================================
+
+#ifndef FLS_OUT_OF_INDEXES
+#define FLS_OUT_OF_INDEXES ((DWORD)0xFFFFFFFF)
+#endif
+
+#ifndef CONDITION_VARIABLE_LOCKMODE_SHARED
+#define CONDITION_VARIABLE_LOCKMODE_SHARED 0x00000001
+#endif
+
+typedef void (WINAPI *PFLS_CALLBACK_FUNCTION)(PVOID lpFlsData);
+
+typedef void (WINAPI *PFN_AcquireSRWLockExclusive)(PSRWLOCK Lock);
+typedef void (WINAPI *PFN_AcquireSRWLockShared)(PSRWLOCK Lock);
+typedef void (WINAPI *PFN_ReleaseSRWLockExclusive)(PSRWLOCK Lock);
+typedef void (WINAPI *PFN_ReleaseSRWLockShared)(PSRWLOCK Lock);
+typedef DWORD (WINAPI *PFN_FlsAlloc)(PFLS_CALLBACK_FUNCTION lpCallback);
+typedef BOOL (WINAPI *PFN_FlsFree)(DWORD dwFlsIndex);
+typedef PVOID (WINAPI *PFN_FlsGetValue)(DWORD dwFlsIndex);
+typedef BOOL (WINAPI *PFN_FlsSetValue)(DWORD dwFlsIndex, PVOID lpFlsData);
+typedef BOOL (WINAPI *PFN_InitializeCriticalSectionEx)(LPCRITICAL_SECTION lpCriticalSection, DWORD dwSpinCount, DWORD Flags);
+typedef BOOL (WINAPI *PFN_SleepConditionVariableSRW)(PCONDITION_VARIABLE ConditionVariable, PSRWLOCK SRWLock, DWORD dwMilliseconds, ULONG Flags);
+typedef void (WINAPI *PFN_WakeAllConditionVariable)(PCONDITION_VARIABLE ConditionVariable);
+typedef void (WINAPI *PFN_WakeConditionVariable)(PCONDITION_VARIABLE ConditionVariable);
+
+// --- SRW LOCK FALLBACK STRUCTURES ---
+
+struct XP_SRW_WAITER {
+    XP_SRW_WAITER* next;
+    HANDLE event;
+    BOOL shared;
+    BOOL granted;
+};
+
+struct XP_SRW_FALLBACK {
+    CRITICAL_SECTION lock;
+    LONG activeReaders;
+    BOOL writerActive;
+    LONG waitingReaders;
+    LONG waitingWriters;
+    XP_SRW_WAITER* waiters;
+};
+
+static XP_SRW_FALLBACK* XPCompatCreateSRWFallback(PSRWLOCK Lock) {
+    if (!Lock) return NULL;
+
+    XP_SRW_FALLBACK* existing = (XP_SRW_FALLBACK*)Lock->Ptr;
+    if (existing) return existing;
+
+    XP_SRW_FALLBACK* p = (XP_SRW_FALLBACK*)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(XP_SRW_FALLBACK));
+    if (!p) return NULL;
+
+    InitializeCriticalSection(&p->lock);
+    p->activeReaders = 0;
+    p->writerActive = FALSE;
+    p->waitingReaders = 0;
+    p->waitingWriters = 0;
+    p->waiters = NULL;
+
+    PVOID old = InterlockedCompareExchangePointer(&Lock->Ptr, p, NULL);
+    if (old != NULL) {
+        DeleteCriticalSection(&p->lock);
+        HeapFree(GetProcessHeap(), 0, p);
+        return (XP_SRW_FALLBACK*)old;
+    }
+
+    return p;
+}
+
+static void XPCompatSRWAddWaiter(XP_SRW_FALLBACK* p, XP_SRW_WAITER* waiter) {
+    waiter->next = NULL;
+    if (!p->waiters) {
+        p->waiters = waiter;
+        return;
+    }
+    XP_SRW_WAITER* q = p->waiters;
+    while (q->next) q = q->next;
+    q->next = waiter;
+}
+
+static void XPCompatSRWGrantWaiters(XP_SRW_FALLBACK* p) {
+    if (p->writerActive || p->activeReaders != 0) return;
+
+    if (p->waitingWriters > 0) {
+        XP_SRW_WAITER* prev = NULL;
+        XP_SRW_WAITER* cur = p->waiters;
+        while (cur) {
+            if (!cur->shared) {
+                if (prev) prev->next = cur->next;
+                else p->waiters = cur->next;
+
+                cur->next = NULL;
+                p->waitingWriters--;
+                p->writerActive = TRUE;
+                cur->granted = TRUE;
+                SetEvent(cur->event);
+                return;
+            }
+            prev = cur;
+            cur = cur->next;
+        }
+        return;
+    }
+
+    XP_SRW_WAITER* prev = NULL;
+    XP_SRW_WAITER* cur = p->waiters;
+    while (cur) {
+        XP_SRW_WAITER* next = cur->next;
+        if (cur->shared) {
+            if (prev) prev->next = next;
+            else p->waiters = next;
+
+            cur->next = NULL;
+            p->waitingReaders--;
+            p->activeReaders++;
+            cur->granted = TRUE;
+            SetEvent(cur->event);
+        } else {
+            prev = cur;
+        }
+        cur = next;
+    }
+}
+
+// --- CONDITION VARIABLE FALLBACK STRUCTURES ---
+
+struct XP_CV_WAITER {
+    XP_CV_WAITER* next;
+    HANDLE event;
+    BOOL signaled;
+};
+
+struct XP_CV_FALLBACK {
+    CRITICAL_SECTION lock;
+    XP_CV_WAITER* waiters;
+    LONG waiterCount;
+};
+
+static XP_CV_FALLBACK* XPCompatCreateCVFallback(PCONDITION_VARIABLE ConditionVariable) {
+    if (!ConditionVariable) return NULL;
+
+    XP_CV_FALLBACK* existing = (XP_CV_FALLBACK*)ConditionVariable->Ptr;
+    if (existing) return existing;
+
+    XP_CV_FALLBACK* p = (XP_CV_FALLBACK*)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(XP_CV_FALLBACK));
+    if (!p) return NULL;
+
+    InitializeCriticalSection(&p->lock);
+    p->waiters = NULL;
+    p->waiterCount = 0;
+
+    PVOID old = InterlockedCompareExchangePointer(&ConditionVariable->Ptr, p, NULL);
+    if (old != NULL) {
+        DeleteCriticalSection(&p->lock);
+        HeapFree(GetProcessHeap(), 0, p);
+        return (XP_CV_FALLBACK*)old;
+    }
+
+    return p;
+}
+
+static void XPCompatCVAddWaiter(XP_CV_FALLBACK* p, XP_CV_WAITER* waiter) {
+    waiter->next = NULL;
+    if (!p->waiters) {
+        p->waiters = waiter;
+    } else {
+        XP_CV_WAITER* q = p->waiters;
+        while (q->next) q = q->next;
+        q->next = waiter;
+    }
+    p->waiterCount++;
+}
+
+static BOOL XPCompatCVRemoveWaiter(XP_CV_FALLBACK* p, XP_CV_WAITER* waiter) {
+    XP_CV_WAITER* prev = NULL;
+    XP_CV_WAITER* cur = p->waiters;
+    while (cur) {
+        if (cur == waiter) {
+            if (prev) prev->next = cur->next;
+            else p->waiters = cur->next;
+
+            cur->next = NULL;
+            if (p->waiterCount > 0) p->waiterCount--;
+            return TRUE;
+        }
+        prev = cur;
+        cur = cur->next;
+    }
+    return FALSE;
+}
+
+// --- FLS EMULATION STRUCTURES ---
+
+struct XP_FLS_SLOT {
+    BOOL inUse;
+    DWORD tlsIndex;
+    PFLS_CALLBACK_FUNCTION callback;
+};
+
+static CRITICAL_SECTION g_FlsLock;
+static volatile LONG g_FlsInitState = 0;
+static XP_FLS_SLOT* g_FlsSlots = NULL;
+static DWORD g_FlsSlotCount = 0;
+#define XP_FLS_INITIAL_SLOTS 128
+
+static BOOL XPCompatInitFls() {
+    LONG state = InterlockedCompareExchange(&g_FlsInitState, 1, 0);
+    if (state == 0) {
+        InitializeCriticalSection(&g_FlsLock);
+        g_FlsSlotCount = XP_FLS_INITIAL_SLOTS;
+        g_FlsSlots = (XP_FLS_SLOT*)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(XP_FLS_SLOT) * g_FlsSlotCount);
+
+        if (!g_FlsSlots) {
+            InterlockedExchange(&g_FlsInitState, 0);
+            return FALSE;
+        }
+        InterlockedExchange(&g_FlsInitState, 2);
+        return TRUE;
+    }
+    while (g_FlsInitState != 2) Sleep(0);
+    return g_FlsSlots != NULL;
+}
+
+static BOOL XPCompatGrowFlsSlots() {
+    DWORD oldCount = g_FlsSlotCount;
+    DWORD newCount = oldCount ? oldCount * 2 : XP_FLS_INITIAL_SLOTS;
+    if (newCount < oldCount) return FALSE;
+
+    XP_FLS_SLOT* newSlots = (XP_FLS_SLOT*)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(XP_FLS_SLOT) * newCount);
+    if (!newSlots) return FALSE;
+
+    if (g_FlsSlots && oldCount) {
+        my_memcpy(newSlots, g_FlsSlots, sizeof(XP_FLS_SLOT) * oldCount);
+        HeapFree(GetProcessHeap(), 0, g_FlsSlots);
+    }
+
+    g_FlsSlots = newSlots;
+    g_FlsSlotCount = newCount;
+    return TRUE;
+}
+
+struct XP_FLS_CALLBACK_ITEM {
+    PFLS_CALLBACK_FUNCTION callback;
+    PVOID data;
+};
+
+extern "C" void WINAPI XPCompatCallFlsCallbacks() {
+    if (g_FlsInitState != 2 || !g_FlsSlots) return;
+
+    XP_FLS_CALLBACK_ITEM* items = NULL;
+    DWORD itemCount = 0;
+
+    EnterCriticalSection(&g_FlsLock);
+    for (DWORD i = 0; i < g_FlsSlotCount; ++i) {
+        if (!g_FlsSlots[i].inUse || !g_FlsSlots[i].callback) continue;
+        PVOID data = TlsGetValue(g_FlsSlots[i].tlsIndex);
+        if (data) itemCount++;
+    }
+
+    if (itemCount) {
+        items = (XP_FLS_CALLBACK_ITEM*)HeapAlloc(GetProcessHeap(), 0, sizeof(XP_FLS_CALLBACK_ITEM) * itemCount);
+    }
+
+    if (items) {
+        DWORD n = 0;
+        for (DWORD i = 0; i < g_FlsSlotCount; ++i) {
+            if (!g_FlsSlots[i].inUse || !g_FlsSlots[i].callback) continue;
+            PVOID data = TlsGetValue(g_FlsSlots[i].tlsIndex);
+            if (!data) continue;
+
+            TlsSetValue(g_FlsSlots[i].tlsIndex, NULL);
+            items[n].callback = g_FlsSlots[i].callback;
+            items[n].data = data;
+            n++;
+        }
+    }
+    LeaveCriticalSection(&g_FlsLock);
+
+    if (items) {
+        for (DWORD n = 0; n < itemCount; ++n) {
+            if (items[n].callback) items[n].callback(items[n].data);
+        }
+        HeapFree(GetProcessHeap(), 0, items);
+    }
+}
