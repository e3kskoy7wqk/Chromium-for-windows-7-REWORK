+extern "C" DWORD WINAPI LibFlsAlloc(PVOID lpCallback) {
+    FETCH_PROC(L"kernel32.dll", FlsAlloc, PFN_FlsAlloc);
+    if (pfn) return pfn((PFLS_CALLBACK_FUNCTION)lpCallback);
+
+    if (!XPCompatInitFls()) return FLS_OUT_OF_INDEXES;
+
+    EnterCriticalSection(&g_FlsLock);
+    for (;;) {
+        for (DWORD i = 0; i < g_FlsSlotCount; ++i) {
+            if (!g_FlsSlots[i].inUse) {
+                DWORD tlsIndex = TlsAlloc();
+                if (tlsIndex == TLS_OUT_OF_INDEXES) {
+                    LeaveCriticalSection(&g_FlsLock);
+                    return FLS_OUT_OF_INDEXES;
+                }
+                g_FlsSlots[i].inUse = TRUE;
+                g_FlsSlots[i].tlsIndex = tlsIndex;
+                g_FlsSlots[i].callback = (PFLS_CALLBACK_FUNCTION)lpCallback;
+                LeaveCriticalSection(&g_FlsLock);
+                return i;
+            }
+        }
+        if (!XPCompatGrowFlsSlots()) {
+            LeaveCriticalSection(&g_FlsLock);
+            return FLS_OUT_OF_INDEXES;
+        }
+    }
+}
+
+extern "C" BOOL WINAPI LibFlsFree(DWORD dwFlsIndex) {
+    FETCH_PROC(L"kernel32.dll", FlsFree, PFN_FlsFree);
+    if (pfn) return pfn(dwFlsIndex);
+
+    if (!XPCompatInitFls()) return FALSE;
+
+    EnterCriticalSection(&g_FlsLock);
+    if (dwFlsIndex >= g_FlsSlotCount || !g_FlsSlots[dwFlsIndex].inUse) {
+        LeaveCriticalSection(&g_FlsLock);
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    DWORD tlsIndex = g_FlsSlots[dwFlsIndex].tlsIndex;
+    g_FlsSlots[dwFlsIndex].inUse = FALSE;
+    g_FlsSlots[dwFlsIndex].tlsIndex = TLS_OUT_OF_INDEXES;
+    g_FlsSlots[dwFlsIndex].callback = NULL;
+
+    BOOL result = TlsFree(tlsIndex);
+    LeaveCriticalSection(&g_FlsLock);
+    return result;
+}
