+extern "C" BOOL WINAPI LibSleepConditionVariableSRW(PCONDITION_VARIABLE ConditionVariable, PSRWLOCK SRWLock, DWORD dwMilliseconds, ULONG Flags) {
+    if (!ConditionVariable || !SRWLock) {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    FETCH_PROC(L"kernel32.dll", SleepConditionVariableSRW, PFN_SleepConditionVariableSRW);
+    if (pfn) return pfn(ConditionVariable, SRWLock, dwMilliseconds, Flags);
+
+    XP_CV_FALLBACK* cv = XPCompatCreateCVFallback(ConditionVariable);
+    if (!cv) {
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+
+    XP_CV_WAITER waiter;
+    waiter.next = NULL;
+    waiter.signaled = FALSE;
+    waiter.event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!waiter.event) return FALSE;
+
+    EnterCriticalSection(&cv->lock);
+    XPCompatCVAddWaiter(cv, &waiter);
+    LeaveCriticalSection(&cv->lock);
+
+    if (Flags & CONDITION_VARIABLE_LOCKMODE_SHARED) LibReleaseSRWLockShared(SRWLock);
+    else LibReleaseSRWLockExclusive(SRWLock);
+
+    DWORD result = WaitForSingleObject(waiter.event, dwMilliseconds);
+    BOOL woke = FALSE;
+
+    EnterCriticalSection(&cv->lock);
+    if (waiter.signaled) {
+        woke = TRUE;
+    } else {
+        if (XPCompatCVRemoveWaiter(cv, &waiter)) woke = FALSE;
+        else woke = TRUE;
+    }
+    LeaveCriticalSection(&cv->lock);
+
+    CloseHandle(waiter.event);
+
+    if (Flags & CONDITION_VARIABLE_LOCKMODE_SHARED) LibAcquireSRWLockShared(SRWLock);
+    else LibAcquireSRWLockExclusive(SRWLock);
+
+    if (woke) return TRUE;
+
+    if (result == WAIT_TIMEOUT) SetLastError(ERROR_TIMEOUT);
+    else SetLastError(ERROR_FUNCTION_FAILED);
+    return FALSE;
+}
+
+extern "C" void WINAPI LibWakeConditionVariable(PCONDITION_VARIABLE ConditionVariable) {
+    if (!ConditionVariable) return;
+
+    FETCH_PROC(L"kernel32.dll", WakeConditionVariable, PFN_WakeConditionVariable);
+    if (pfn) { pfn(ConditionVariable); return; }
+
+    XP_CV_FALLBACK* cv = (XP_CV_FALLBACK*)ConditionVariable->Ptr;
+    if (!cv) return;
+
+    EnterCriticalSection(&cv->lock);
+    XP_CV_WAITER* waiter = cv->waiters;
+    if (waiter) {
+        cv->waiters = waiter->next;
+        waiter->next = NULL;
+        if (cv->waiterCount > 0) cv->waiterCount--;
+        waiter->signaled = TRUE;
+        SetEvent(waiter->event);
+    }
+    LeaveCriticalSection(&cv->lock);
+}
+
+extern "C" void WINAPI LibWakeAllConditionVariable(PCONDITION_VARIABLE ConditionVariable) {
+    if (!ConditionVariable) return;
+
+    FETCH_PROC(L"kernel32.dll", WakeAllConditionVariable, PFN_WakeAllConditionVariable);
+    if (pfn) { pfn(ConditionVariable); return; }
+
+    XP_CV_FALLBACK* cv = (XP_CV_FALLBACK*)ConditionVariable->Ptr;
+    if (!cv) return;
+
+    EnterCriticalSection(&cv->lock);
+    XP_CV_WAITER* waiter = cv->waiters;
+    cv->waiters = NULL;
+    cv->waiterCount = 0;
+
+    while (waiter) {
+        XP_CV_WAITER* next = waiter->next;
+        waiter->next = NULL;
+        waiter->signaled = TRUE;
+        SetEvent(waiter->event);
+        waiter = next;
+    }
+    LeaveCriticalSection(&cv->lock);
+}
