+extern "C" BOOL WINAPI LibInitializeCriticalSectionEx(LPCRITICAL_SECTION lpCriticalSection, DWORD dwSpinCount, DWORD Flags) {
+    if (!lpCriticalSection) {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    FETCH_PROC(L"kernel32.dll", InitializeCriticalSectionEx, PFN_InitializeCriticalSectionEx);
+    if (pfn) return pfn(lpCriticalSection, dwSpinCount, Flags);
+
+    typedef BOOL (WINAPI *PFN_ICSASC)(LPCRITICAL_SECTION, DWORD);
+    FETCH_PROC_EX(L"kernel32.dll", "InitializeCriticalSectionAndSpinCount", PFN_ICSASC, pfnSpin);
+    if (pfnSpin) return pfnSpin(lpCriticalSection, dwSpinCount);
+
+    InitializeCriticalSection(lpCriticalSection);
+    return TRUE;
+}
