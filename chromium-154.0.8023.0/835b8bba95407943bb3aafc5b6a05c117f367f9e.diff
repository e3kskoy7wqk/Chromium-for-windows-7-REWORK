+uniform mediump samplerVideoWEBGL s;
+out vec4 my_FragColor;
+void main() {
+    my_FragColor = texture(s, vec2(0.0, 0.0));
+})";
+    // samplerVideoWEBGL is not a reserved keyword, and the translator fails with syntax
