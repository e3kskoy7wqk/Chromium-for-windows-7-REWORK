+        EXPECT_EQ(MOJO_RESULT_OK, MojoClose(a_trap_handle));
+      },
+      [&] {
+        b_cancelled = true;
+        wait_for_b_to_cancel.Signal();
+        wait_for_a_to_cancel.Wait();
+      });
