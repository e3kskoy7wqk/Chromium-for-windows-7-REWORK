+      // crbug.com/439917450.
+      feature_list_.InitAndEnableFeature(mojo::core::kMojoIpcz);
+    }
+  }
+#endif  // BUILDFLAG(MOJO_SUPPORT_LEGACY_CORE)
+}
 
 ChromeOSIntegrationTestMixin::~ChromeOSIntegrationTestMixin() = default;
 
