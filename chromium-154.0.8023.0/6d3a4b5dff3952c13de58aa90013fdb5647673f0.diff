+    std::vector<std::string_view> flags = base::SplitStringPiece(
+        data, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (std::find(flags.begin(), flags.end(), kMojoIpczUseFlag) !=
+        flags.end()) {
