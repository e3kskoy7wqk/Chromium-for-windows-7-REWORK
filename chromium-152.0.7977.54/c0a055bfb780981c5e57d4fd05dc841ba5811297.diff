+#ifdef  __ANDROID__
+#if !defined(ANDROID_NDK_BUILD)
+#include <utils/String8.h>
+#if ANDROID_PLATFORM_SDK_VERSION < 27
+#include <cutils/log.h>
+#elif ANDROID_PLATFORM_SDK_VERSION >= 27
