+	// Detach if currently bound.
+	if(mState.transformFeedback == transformFeedback)
+	{
+		mState.transformFeedback = 0;
+	}
+
+	if(transformFeedbackObject)
+	{
+		delete transformFeedbackObject;
+	}
+}
