+bool Texture3D::isShared(GLenum target, unsigned int level) const
+{
+	ASSERT(target == getTarget());
+	ASSERT(level < IMPLEMENTATION_MAX_TEXTURE_LEVELS);
+
+	if(mSurface)   // Bound to an EGLSurface
+	{
+		return true;
+	}
+
+	if(!image[level])
+	{
+		return false;
+	}
+
+	return image[level]->isShared();
+}
