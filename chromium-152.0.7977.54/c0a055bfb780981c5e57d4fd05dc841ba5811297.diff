diff --git a/third_party/swiftshader/src/OpenGL/compiler/preprocessor/DiagnosticsBase.cpp b/third_party/swiftshader/src/OpenGL/compiler/preprocessor/DiagnosticsBase.cpp
new file mode 100644
index 000000000..0cea776da
