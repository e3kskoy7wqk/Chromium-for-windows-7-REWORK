+static bool validImageSize(GLint level, GLsizei width, GLsizei height)
+{
+	if(level < 0 || level >= IMPLEMENTATION_MAX_TEXTURE_LEVELS || width < 0 || height < 0)
+	{
+		return false;
+	}
+
+	return true;
+}
