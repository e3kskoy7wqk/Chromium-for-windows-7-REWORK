diff --git a/third_party/swiftshader/src/Renderer/SetupProcessor.cpp b/third_party/swiftshader/src/Renderer/SetupProcessor.cpp
new file mode 100644
index 000000000..f23068fe9
--- /dev/null
+++ b/third_party/swiftshader/src/Renderer/SetupProcessor.cpp
@@ -0,0 +1,246 @@
+// Copyright 2016 The SwiftShader Authors. All Rights Reserved.
+//
