+	Matrix Matrix::diag(float m11, float m22, float m33, float m44)
+	{
+		return Matrix(m11, 0,   0,   0,
+		              0,   m22, 0,   0,
+		              0,   0,   m33, 0,
+		              0,   0,   0,   m44);
