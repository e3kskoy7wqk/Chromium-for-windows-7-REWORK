+		if((getTarget() == GL_TEXTURE_EXTERNAL_OES) || (getTarget() == GL_TEXTURE_RECTANGLE_ARB))
+		{
+			return false;
+		}
+		// Fall through
+	case GL_CLAMP_TO_EDGE:
+		mWrapT = wrap;
+		return true;
+	default:
+		return false;
+	}
