+// main.cpp: DLL entry point and management of thread-local data.
+
+#include "main.h"
+
+#include "Context.hpp"
+#include "Display.h"
+#include "Surface.hpp"
+#include "libEGL.hpp"
+
+#include "Common/SharedLibrary.hpp"
+#include "Common/Thread.hpp"
+#include "common/debug.h"
