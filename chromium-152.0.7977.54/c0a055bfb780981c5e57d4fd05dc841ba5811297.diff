+private:
+	LibGLESv2exports *loadExports()
+	{
+		if(!loadLibraryAttempted && !libGLESv2)
+		{
+			#if defined(_WIN32)
+				#if defined(__LP64__)
+					const char *libGLESv2_lib[] = {"libswiftshader_libGLESv2.dll", "libGLESv2.dll", "lib64GLES_V2_translator.dll", "libGLESv2_deprecated.dll"};
