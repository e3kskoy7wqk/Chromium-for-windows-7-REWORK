+	void ShaderCore::sgn(Float4 &dst, const Float4 &src)
+	{
+		Int4 neg = As<Int4>(CmpLT(src, Float4(-0.0f))) & As<Int4>(Float4(-1.0f));
+		Int4 pos = As<Int4>(CmpNLE(src, Float4(+0.0f))) & As<Int4>(Float4(1.0f));
+		dst = As<Float4>(neg | pos);
+	}
