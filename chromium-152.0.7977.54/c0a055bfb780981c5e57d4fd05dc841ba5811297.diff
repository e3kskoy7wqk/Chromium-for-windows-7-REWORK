+	void UniformBlock::setRegisterIndex(GLenum shader, unsigned int registerIndex)
+	{
+		switch(shader)
+		{
+		case GL_VERTEX_SHADER:
+			vsRegisterIndex = registerIndex;
+			break;
+		case GL_FRAGMENT_SHADER:
+			psRegisterIndex = registerIndex;
+			break;
+		default:
+			UNREACHABLE(shader);
+		}
+	}
