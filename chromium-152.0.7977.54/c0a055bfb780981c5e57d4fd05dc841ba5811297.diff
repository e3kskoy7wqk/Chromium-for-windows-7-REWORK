+{
+	return pixelShader;
+}
+
+void FragmentShader::createShader()
+{
+	delete pixelShader;
+	pixelShader = new sw::PixelShader();
+}
+
+void FragmentShader::deleteShader()
+{
+	delete pixelShader;
+	pixelShader = nullptr;
+}
+
+}
