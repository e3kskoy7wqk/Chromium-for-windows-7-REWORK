+			}
+		}
+
+		if(currentLabel != -1)
+		{
+			Nucleus::setInsertBlock(returnBlock);
+		}
+
+		if(broadcastColor0)
+		{
+			for(int i = 0; i < RENDERTARGETS; i++)
