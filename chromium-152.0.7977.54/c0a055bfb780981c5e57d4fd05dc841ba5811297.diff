+
+		void setWriteSRGB(bool sRGB);
+		void setDepthBufferEnable(bool depthBufferEnable);
+		void setDepthCompare(DepthCompareMode depthCompareMode);
+		void setAlphaCompare(AlphaCompareMode alphaCompareMode);
