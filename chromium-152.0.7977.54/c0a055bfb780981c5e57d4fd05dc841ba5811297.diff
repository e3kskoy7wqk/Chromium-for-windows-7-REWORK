+        (yyval) = (yyvsp[-2]) >= (yyvsp[0]);
+    }
+
+    break;
+
+  case 15:
+
+    {
+        (yyval) = (yyvsp[-2]) <= (yyvsp[0]);
+    }
+
+    break;
+
+  case 16:
+
+    {
+        (yyval) = (yyvsp[-2]) > (yyvsp[0]);
+    }
+
+    break;
+
+  case 17:
+
