+#undef KeRaiseIrql
+#endif
+#define KeRaiseIrql(NewLevel, OldLevel)
+#ifdef KeLowerIrql
+#undef KeLowerIrql
+#endif
+#define KeLowerIrql(Level)
+//
+// Interrupt Request Level (IRQL)
+//
+
+typedef UCHAR KIRQL;
+typedef KIRQL *PKIRQL;
