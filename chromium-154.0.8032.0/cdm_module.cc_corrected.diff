+static bool HookKernel32Export(const char* func_name, void* new_function) {
+  HMODULE hKernel32 = GetModuleHandleW(L"kernel32.dll");
+  if (!hKernel32) return false;
+
+  void* actual_target = new_function;
+
+#if defined(_WIN64)
+  actual_target = WriteTrampolineInKernel32(hKernel32, new_function);
+  if (!actual_target) return false;
+#endif
+
+  ULONG size = 0;
+  PIMAGE_EXPORT_DIRECTORY pExportDir = (PIMAGE_EXPORT_DIRECTORY)ImageDirectoryEntryToData(
+      hKernel32, TRUE, IMAGE_DIRECTORY_ENTRY_EXPORT, &size);
+  if (!pExportDir) return false;
+
+  PDWORD pNames = (PDWORD)((PBYTE)hKernel32 + pExportDir->AddressOfNames);
+  PWORD pOrdinals = (PWORD)((PBYTE)hKernel32 + pExportDir->AddressOfNameOrdinals);
+  PDWORD pFunctions = (PDWORD)((PBYTE)hKernel32 + pExportDir->AddressOfFunctions);
+
+  for (DWORD i = 0; i < pExportDir->NumberOfNames; i++) {
+    char* pszName = (char*)((PBYTE)hKernel32 + pNames[i]);
+    if (strcmp(pszName, func_name) == 0) {
+      WORD ordinal = pOrdinals[i];
+      DWORD dwOldProtect = 0;
+
+      DWORD newRva = static_cast<DWORD>((PBYTE)actual_target - (PBYTE)hKernel32);
+
+      if (VirtualProtect(&pFunctions[ordinal], sizeof(DWORD), PAGE_READWRITE, &dwOldProtect)) {
+        pFunctions[ordinal] = newRva;
+        VirtualProtect(&pFunctions[ordinal], sizeof(DWORD), dwOldProtect, &dwOldProtect);
+        FlushInstructionCache(GetCurrentProcess(), &pFunctions[ordinal], sizeof(DWORD));
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+static void PrepareHookWin7() {
+  if (base::win::GetVersion() != base::win::Version::WIN7) {
+    return;
+  }
+
+  static bool prepared = false;
+  if (prepared) return;
+  prepared = true;
+
+  HMODULE hKernel32 = GetModuleHandleW(L"kernel32.dll");
+  if (hKernel32) {
+    g_RealGetProcAddress = reinterpret_cast<GetProcAddressProc>(
+        ::GetProcAddress(hKernel32, "GetProcAddress"));
+  }
+
+  ReplaceKernel32ExportName("GetProcessPreferredUILanguages", "GetProcessMitigationPolicy");
+  ReplaceKernel32ExportName("SetThreadIdealProcessorEx", "SetThreadInformation");
+
+  HookKernel32Export("GetProcAddress", reinterpret_cast<void*>(&My_GetProcAddress));
+}
+
+static void PatchCdmImports(HMODULE hCdmModule) {
+  if (!hCdmModule) return;
+
+  if (base::win::GetVersion() != base::win::Version::WIN7) {
+    return;
+  }
+
+  ULONG size;
+  PIMAGE_IMPORT_DESCRIPTOR pImportDesc = (PIMAGE_IMPORT_DESCRIPTOR)ImageDirectoryEntryToData(
+      hCdmModule, TRUE, IMAGE_DIRECTORY_ENTRY_IMPORT, &size);
+
+  if (!pImportDesc) return;
+
+  for (; pImportDesc->Name; pImportDesc++) {
+    PSTR pszModName = (PSTR)((PBYTE)hCdmModule + pImportDesc->Name);
+
+    if (_stricmp(pszModName, "kernel32.dll") == 0 ||
+        _stricmp(pszModName, "bcryptprimitives.dll") == 0) {
+
+      PIMAGE_THUNK_DATA pThunk = (PIMAGE_THUNK_DATA)((PBYTE)hCdmModule + pImportDesc->FirstThunk);
+      PIMAGE_THUNK_DATA pOriginalThunk = (PIMAGE_THUNK_DATA)((PBYTE)hCdmModule + (pImportDesc->OriginalFirstThunk ? pImportDesc->OriginalFirstThunk : pImportDesc->FirstThunk));
+
+      for (; pThunk->u1.Function; pThunk++, pOriginalThunk++) {
+        if (IMAGE_SNAP_BY_ORDINAL(pOriginalThunk->u1.Ordinal)) {
+          continue;
+        }
+
+        PIMAGE_IMPORT_BY_NAME pImport = (PIMAGE_IMPORT_BY_NAME)((PBYTE)hCdmModule + pOriginalThunk->u1.AddressOfData);
+        if (!pImport) continue;
+
+        LPCSTR pszFuncName = (LPCSTR)pImport->Name;
+
+        FARPROC pTargetFunc = nullptr;
+
+        if (strcmp(pszFuncName, "GetProcAddress") == 0) {
+          pTargetFunc = reinterpret_cast<FARPROC>(&My_GetProcAddress);
+        } else if (strcmp(pszFuncName, "ProcessPrng") == 0) {
+          pTargetFunc = reinterpret_cast<FARPROC>(&My_ProcessPrng);
+        } else if (strcmp(pszFuncName, "SetThreadInformation") == 0) {
+          pTargetFunc = reinterpret_cast<FARPROC>(&My_SetThreadInformation);
+        } else if (strcmp(pszFuncName, "GetProcessMitigationPolicy") == 0) {
+          pTargetFunc = reinterpret_cast<FARPROC>(&My_GetProcessMitigationPolicy);
+        }
+
+        if (pTargetFunc) {
+          DWORD dwOldProtect;
+          if (VirtualProtect(&pThunk->u1.Function, sizeof(ULONG_PTR), PAGE_READWRITE, &dwOldProtect)) {
+            pThunk->u1.Function = (ULONG_PTR)pTargetFunc;
+            VirtualProtect(&pThunk->u1.Function, sizeof(ULONG_PTR), dwOldProtect, &dwOldProtect);
+            FlushInstructionCache(GetCurrentProcess(), &pThunk->u1.Function, sizeof(ULONG_PTR));
+          }
+        }
+      }
+    }
+  }
+}
