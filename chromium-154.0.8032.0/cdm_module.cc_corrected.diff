+typedef BOOLEAN (APIENTRY *RtlGenRandomFunc)(PVOID, ULONG);
+static BOOL WINAPI My_ProcessPrng(PBYTE pbBuffer, SIZE_T cbBuffer) {
+  HMODULE hAdvApi = GetModuleHandleW(L"advapi32.dll");
+  if (!hAdvApi) {
+    hAdvApi = ::LoadLibraryW(L"advapi32.dll");
+  }
+  if (hAdvApi) {
+    RtlGenRandomFunc RtlGenRandom = reinterpret_cast<RtlGenRandomFunc>(
+        ::GetProcAddress(hAdvApi, "SystemFunction036"));
+    if (RtlGenRandom) {
+      return RtlGenRandom(pbBuffer, static_cast<ULONG>(cbBuffer));
+    }
+  }
+  return FALSE;
+}
+
+static BOOL WINAPI My_SetThreadInformation(HANDLE hThread,
+                                           DWORD ThreadInformationClass,
+                                           LPVOID ThreadInformation,
+                                           DWORD ThreadInformationSize) {
+  SetLastError(ERROR_SUCCESS);
+  return TRUE;
+}
+
+static BOOL WINAPI My_GetProcessMitigationPolicy(HANDLE hProcess,
+                                                 DWORD MitigationPolicy,
+                                                 PVOID lpBuffer,
+                                                 SIZE_T dwLength) {
+  if (lpBuffer && dwLength > 0) {
+    ZeroMemory(lpBuffer, dwLength);
+  }
+  SetLastError(ERROR_SUCCESS);
+  return TRUE;
+}
+
+typedef FARPROC (WINAPI *GetProcAddressProc)(HMODULE hModule, LPCSTR lpProcName);
+static GetProcAddressProc g_RealGetProcAddress = nullptr;
+
+static FARPROC WINAPI My_GetProcAddress(HMODULE hModule, LPCSTR lpProcName) {
+  if (!IS_INTRESOURCE(lpProcName)) {
+    if (strcmp(lpProcName, "ProcessPrng") == 0) {
+      return reinterpret_cast<FARPROC>(&My_ProcessPrng);
+    }
+    if (strcmp(lpProcName, "SetThreadInformation") == 0) {
+      return reinterpret_cast<FARPROC>(&My_SetThreadInformation);
+    }
+    if (strcmp(lpProcName, "GetProcessMitigationPolicy") == 0) {
+      return reinterpret_cast<FARPROC>(&My_GetProcessMitigationPolicy);
+    }
+  }
+
+  return g_RealGetProcAddress ? g_RealGetProcAddress(hModule, lpProcName) : nullptr;
+}
