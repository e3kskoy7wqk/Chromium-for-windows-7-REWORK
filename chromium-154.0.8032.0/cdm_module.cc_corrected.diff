+static bool ReplaceKernel32ExportName(const char* old_name, const char* new_name) {
+  HMODULE hKernel32 = GetModuleHandleW(L"kernel32.dll");
+  if (!hKernel32) return false;
+
+  ULONG size = 0;
+  PIMAGE_EXPORT_DIRECTORY pExportDir = (PIMAGE_EXPORT_DIRECTORY)ImageDirectoryEntryToData(
+      hKernel32, TRUE, IMAGE_DIRECTORY_ENTRY_EXPORT, &size);
+  if (!pExportDir) return false;
+
+  PDWORD pNames = (PDWORD)((PBYTE)hKernel32 + pExportDir->AddressOfNames);
+  for (DWORD i = 0; i < pExportDir->NumberOfNames; i++) {
+    char* pszName = (char*)((PBYTE)hKernel32 + pNames[i]);
+    if (strcmp(pszName, old_name) == 0) {
+      DWORD dwOldProtect = 0;
+      size_t new_name_len = strlen(new_name) + 1;
+
+      if (VirtualProtect(pszName, new_name_len, PAGE_READWRITE, &dwOldProtect)) {
+        memcpy(pszName, new_name, new_name_len);
+        VirtualProtect(pszName, new_name_len, dwOldProtect, &dwOldProtect);
+        FlushInstructionCache(GetCurrentProcess(), pszName, new_name_len);
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+#if defined(_WIN64)
+static void* WriteTrampolineInKernel32(HMODULE hKernel32, void* target_func) {
+  PIMAGE_DOS_HEADER pDos = (PIMAGE_DOS_HEADER)hKernel32;
+  PIMAGE_NT_HEADERS pNt = (PIMAGE_NT_HEADERS)((PBYTE)hKernel32 + pDos->e_lfanew);
+
+  PIMAGE_SECTION_HEADER pSec = IMAGE_FIRST_SECTION(pNt);
+  for (WORD i = 0; i < pNt->FileHeader.NumberOfSections; i++, pSec++) {
+    if (memcmp(pSec->Name, ".text", 5) == 0) {
+      PBYTE pSecEnd = (PBYTE)hKernel32 + pSec->VirtualAddress + pSec->Misc.VirtualSize;
+      PBYTE pTrampolineLocation = (PBYTE)(((uintptr_t)pSecEnd + 15) & ~15);
+
+      DWORD dwOldProtect = 0;
+      size_t trampSize = 14;
+      if (VirtualProtect(pTrampolineLocation, trampSize, PAGE_EXECUTE_READWRITE, &dwOldProtect)) {
+        BYTE code[14] = {
+          0xFF, 0x25, 0x00, 0x00, 0x00, 0x00, // JMP [RIP+0]
+          0,0,0,0,0,0,0,0
+        };
+        uintptr_t addr = reinterpret_cast<uintptr_t>(target_func);
+        memcpy(&code[6], &addr, sizeof(addr));
+
+        memcpy(pTrampolineLocation, code, trampSize);
+        VirtualProtect(pTrampolineLocation, trampSize, dwOldProtect, &dwOldProtect);
+        FlushInstructionCache(GetCurrentProcess(), pTrampolineLocation, trampSize);
+
+        return pTrampolineLocation;
+      }
+    }
+  }
+  return nullptr;
+}
+#endif
