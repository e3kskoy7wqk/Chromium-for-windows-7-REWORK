+angle::Result Buffer9::markTransformFeedbackUsage(const gl::Context *context,
+                                                  BufferFeedback *feedback)
+{
+    ANGLE_HR_UNREACHABLE(GetImplAs<Context9>(context));
+    return angle::Result::Stop;
+}
+
+}  // namespace rx
